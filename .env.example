# Copy to .env, then run: npm run build:env   (writes public/env.js)
# All optional. With nothing set the app runs fully in the browser.

# Firebase (optional run history). Firebase console > Project settings > Your apps > Web app.
# Enable Authentication > Anonymous and create a Firestore database, then deploy firestore.rules.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Cloudflare Worker URL for the optional AI morning briefing (see worker/).
# The Anthropic API key is stored only as a Worker secret, never in the browser.
LLM_PROXY_URL=
