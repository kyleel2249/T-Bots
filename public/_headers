/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self'; img-src 'self' data:; connect-src 'self' https://api.dexscreener.com https://api.rugcheck.xyz https://*.googleapis.com https://*.firebaseio.com https://*.workers.dev; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
/js/*
  Cache-Control: public, max-age=300
/css/*
  Cache-Control: public, max-age=300
